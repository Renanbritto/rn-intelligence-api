# ==============================================================================
# RN Intelligence API - Configuração de Ambiente
# ==============================================================================

# Google Gemini API Key (Obtenha gratuitamente em https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Servidor
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True

# CORS - Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,https://sales-bi-ai-copilot.vercel.app,*

# Diretório base de dados para projetos (DuckDB/SQLite)
DATA_DIR=data
